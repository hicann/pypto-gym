# PyPTO-Pro A5 Acc -> Vec mailbox skeleton.
# Replace tile types, valid shapes and bodies from DESIGN.md. This fragment is
# intentionally one-slot: READY publishes data and FREE supplies backpressure.
# Use one shared TileGroup object in both sections. A manual Vec make_tile plus
# events is not a substitute for mutex ownership on current A5 PyPTO-Pro.
#
# HARD GATE: this skeleton is not validated by compiling or returning from a
# real-block launch. Before using it in a full operator, run a bounded
# production-shaped probe that checks both liveness and bit-exact aligned/odd
# tails, including untouched invalid-row sentinels. Any timeout, device error,
# mismatch, sentinel overwrite, or missing tail rejects Stage A and must not
# proceed to the full operator.
# If production carries a FREE/READY token through pl.system.sync_all(), the
# probe must contain the same seed -> first wave -> MIX barrier -> second-wave
# reuse. Matching total set/wait counts and a barrier-free probe do not prove
# cross-barrier token lifetime. After a device error, close that source SHA;
# change the protocol and use a new SHA before any retry.
# Before generated-code performance work, run the smallest selected production
# case under a 300-second wall-clock watchdog. Source/static/math PASS does not
# prove liveness. A timeout, stuck launch, or sustained AIC/Aicube activity
# with AIV idle is a runtime NO-GO; preserve CCE/counters and skip ABBA.

READY_EVENT = 0
MAILBOX_FREE_EVENT = 1

# Declare shared Acc/Vec groups once at kernel scope, before either section.
# A group created inside section_vector and referenced by section_cube lowers
# to an unregistered block.current on the current A5 frontend. Use unique mutex
# ids in [0, 31] and disjoint addresses in each memory space. Both sections call
# current() on this exact one-slot group; never create a second cursor with the
# same mutex id.
vec_mailbox_g = pl.make_tile_group(
    type=vec_mailbox_type,
    addrs=VEC_MAILBOX_ADDR,
    mutex_ids=[VEC_MAILBOX_MUTEX],
)

with pl.section_cube():
    vec_mailbox_cube = vec_mailbox_g.current()
    # Both AIV lanes seed FREE before the first producer wait.
    pl.system.wait_cross_core(
        pipe=pl.PipeType.FIX,
        event_id=MAILBOX_FREE_EVENT,
        sync_mode=pl.CrossCoreSyncMode.INTRA_BLOCK,
    )

    cube_producer_body(acc_tile)
    pl.move(
        vec_mailbox_cube,
        acc_tile,
        acc_to_vec_mode=pl.AccToVecMode.DualModeSplitM,
    )
    pl.system.set_cross_core(
        pipe=pl.PipeType.FIX,
        event_id=READY_EVENT,
        sync_mode=pl.CrossCoreSyncMode.INTRA_BLOCK,
    )

with pl.section_vector():
    vec_mailbox_aiv = vec_mailbox_g.current()
    sub_id = pl.get_subblock_idx()
    valid_m_even = (valid_m + 1) // 2 * 2
    vec0_rows = valid_m_even // 2
    if sub_id == 0:
        sub_row_base = 0
        sub_rows = vec0_rows
    else:
        sub_row_base = vec0_rows
        sub_rows = valid_m - vec0_rows

    # Do not replace this logical split with sub_id * physical_half. A
    # block_dim launch that returns proves only liveness, not odd-tail mapping.

    # Every subblock participates even when sub_rows == 0.
    pl.system.set_cross_core(
        pipe=pl.PipeType.V,
        event_id=MAILBOX_FREE_EVENT,
        sync_mode=pl.CrossCoreSyncMode.INTRA_BLOCK,
    )

    pl.system.wait_cross_core(
        pipe=pl.PipeType.V,
        event_id=READY_EVENT,
        sync_mode=pl.CrossCoreSyncMode.INTRA_BLOCK,
    )

    if sub_rows > 0:
        vector_consumer_body(
            vec_mailbox_aiv, sub_row_base, sub_rows, vector_scratch_or_output,
        )

    # This example finishes reading the mailbox on V. If GM MTE3 reads the
    # mailbox directly, release on MTE3 instead. If VF first copies into a
    # separate BF16 store tile, release the mailbox here on V and protect the
    # store tile with a different FREE event produced on MTE3. Never alternate
    # V and MTE3 producers on one FREE event to represent two resources.
    pl.system.set_cross_core(
        pipe=pl.PipeType.V,
        event_id=MAILBOX_FREE_EVENT,
        sync_mode=pl.CrossCoreSyncMode.INTRA_BLOCK,
    )

