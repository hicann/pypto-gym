# PyPTO-Pro typed TileGroups that reuse one physical arena across hard stages.
# Replace symbolic IDs/addresses and prove the live intervals for the operator.

RHS_BASE = 0x00000
NARROW_BYTES = TK * TN * 2
WIDE_BYTES = TK * (2 * TN) * 2

assert 2 * NARROW_BYTES <= L0B_CAPACITY
assert WIDE_BYTES <= L0B_CAPACITY

narrow_rhs_g = pl.make_tile_group(
    type=pl.TileType(
        shape=[TK, TN], dtype=pl.DT_BF16,
        target_memory=pl.MemorySpace.Right, layout=pl.ZN,
        valid_shape=[-1, -1], compact=1,
    ),
    addrs=RHS_BASE,
    # Two values are consumed together, so two physical slots are mandatory.
    mutex_ids=[NARROW_RHS_0, NARROW_RHS_1],
)

wide_rhs_g = pl.make_tile_group(
    type=pl.TileType(
        shape=[TK, 2 * TN], dtype=pl.DT_BF16,
        target_memory=pl.MemorySpace.Right, layout=pl.ZN,
        valid_shape=[-1, -1], compact=1,
    ),
    # Physical alias with narrow_rhs_g is safe only across proved hard stages.
    addrs=RHS_BASE,
    mutex_ids=[WIDE_RHS_0],
)

with pl.section_cube():
    ...  # first narrow_rhs_g computation; inline it rather than call an ordinary Python helper

# Every launched AIC/AIV lane must reach this unconditionally.  auto_mutex does
# not discover that two differently typed groups alias the same address.
pl.system.sync_all(core_type=pl.SyncCoreType.MIX)

with pl.section_cube():
    ...  # inline wide_rhs_g computation

pl.system.sync_all(core_type=pl.SyncCoreType.MIX)

with pl.section_cube():
    ...  # inline final narrow_rhs_g computation

