# PyPTO-Pro A5 VF scalar-broadcast dot-product fragment.
#
# This is not a standalone kernel. Replace panel dimensions, tile strides,
# masks and compensation with the operator's frozen design. A normal
# vf.load_align is a register-width load even when its offset names one scalar.
# CCE and a one-row probe are insufficient: separately gate a production-shaped
# multi-row loop on the exact target A5 before accepting this skeleton.
# This skeleton covers full GROUP_K blocks only. Keep this compile-time guard,
# or replace it with an explicit K-tail path before using a non-divisible panel.

assert PANEL_K % GROUP_K == 0

@pl.vector_function
def accumulate_panel_vf(
    lhs,
    weight_panel,
    high_tile,
    low_tile,
    valid_rows: pl.DT_INT64,
):
    predicate = vf.update_mask(OUTPUT_WIDTH, dtype=pl.DT_FP32)
    for row in pl.range(0, valid_rows):
        lhs_row = row * LHS_ROW_STRIDE
        state_row = row * STATE_ROW_STRIDE
        high = vf.load_align(high_tile, state_row)
        low = vf.load_align(low_tile, state_row)

        for group in pl.range(0, PANEL_K // GROUP_K):
            group_sum = vf.full(0.0, predicate, dtype=pl.DT_FP32)
            for inner in pl.range(0, GROUP_K):
                k = group * GROUP_K + inner
                scalar = vf.load_align(
                    lhs,
                    lhs_row + k,
                    dist=pl.LoadDist.BRC_B32,
                )
                weight = vf.load_align(
                    weight_panel,
                    k * WEIGHT_ROW_STRIDE,
                )
                # One VF call per statement: the API is a three-address
                # call model, so a value-producing VF call cannot be nested as
                # another call's argument. Bind each intermediate first.
                weighted = vf.mul(weight, scalar, predicate)
                group_sum = vf.add(
                    group_sum,
                    weighted,
                    predicate,
                )

            # Optional TwoSum state. Remove only after the real checker proves
            # that cancellation is irrelevant for this output.
            updated = vf.add(high, group_sum, predicate)
            bridge = vf.sub(updated, high, predicate)
            recovered = vf.sub(updated, bridge, predicate)
            high_error = vf.sub(high, recovered, predicate)
            group_error = vf.sub(group_sum, bridge, predicate)
            carried = vf.add(high_error, group_error, predicate)
            low = vf.add(
                low,
                carried,
                predicate,
            )
            high = updated

        vf.store_align(high_tile + state_row, high, predicate)
        vf.store_align(low_tile + state_row, low, predicate)

    # Required when a following Tile cast or VF call reads these scratch tiles.
    vf.mem_bar(mode=pl.MemBarMode.VST_VLD)
