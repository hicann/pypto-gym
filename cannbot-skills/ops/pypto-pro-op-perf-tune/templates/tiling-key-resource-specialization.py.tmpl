# PyPTO-Pro single-JIT compile-time resource specialization.
# Keep the wrapper at one launch and verify every emitted key-specific IR.

from pypto_pro.runtime.tilingkey import TilingKeyField


class KernelModeKey:
    KernelMode = TilingKeyField(bits=1, values=[0, 1])


@pl.jit(auto_mutex=True, tiling_key=KernelModeKey)
def fused_kernel(public_tensor, conservative_workspace, optimized_workspace):
    # KernelMode is injected by the frontend. The branch must disappear from
    # emitted IR; do not replace it with a runtime tensor-shape condition.
    #
    # Both branch bodies are written out here in full. A `@pl.jit` body is an
    # AST the parser walks but never executes, so it cannot follow a call into
    # a plain Python helper -- the call surfaces as a pybind "incompatible
    # constructor arguments" error far from the mistake. Eliminating the branch
    # at compile time does not change that: whichever body survives still has
    # to be inline. Inline it, or lift it to a value the parser can see.
    if KernelMode == 0:  # noqa: F821
        ...  # conservative chain, written inline: tile groups, loads, matmul
             # phases and stores for the resource-conservative shape
    else:
        ...  # optimized chain, written inline, same contract and precision


def wrapper(public_tensor):
    # Host scalar metadata may choose a key. Both branches still need full
    # contract, precision, ownership and capacity validation.
    mode = 1 if use_optimized_static_mode() else 0
    conservative_workspace = allocate_conservative_workspace()
    optimized_workspace = allocate_optimized_workspace()
    fused_kernel[None, block_dim, {"KernelMode": mode}](
        public_tensor, conservative_workspace, optimized_workspace,
    )
