import argparse

import torch
from ascriptor.runtime import LAUNCHERS, OpExec

from kernel import entry  # TODO the kernel(s) this demo launches
from reference import make_inputs, reference  # TODO add reference_stages for a pipeline

# TODO. `None` claims the kernel reproduces the reference bit for bit, which is a claim
# about the arithmetic: it holds when every product and sum in the formula is exact for
# the generated inputs and both sides perform the same roundings. Otherwise a dict --
# {"rtol": ..., "atol": ...} -- whose bound describes the seam that justifies it (a named
# cast, one contracted multiply-add), not the failure it was raised to cover.
TOLERANCE = None

# Each case is the deterministic input recipe reference.make_inputs reads. Pick sizes
# against the thing the demo is about -- a slot ring that wraps zero, once and several
# times; a partition that ends on a partial tile -- not for coverage. A case is never
# widened, shrunk or deleted to make it pass; if it cannot run where it is being run it
# is skipped with the reason printed, and the reason says what to run instead.
CASES = [
    {"id": "TODO", "seed": 0, "block_dim": 1,
     "purpose": "TODO what this case is the only one to exercise",
     "parameters": {}},
]


def execute(case, inputs, launcher, backend):
    """Launch the kernel and return its actual outputs, keyed as reference() keys them.

    `seed_outputs=True` hands the kernel the caller's poisoned output tensor, so a lane
    the kernel never writes keeps its NaN instead of reading back as a zero. Never call
    the reference from here as a fallback: that would make the check compare the
    reference with itself.
    """
    op = OpExec(entry, launcher=launcher, backend=backend, device="a5",  # TODO device
                block_dim=case["block_dim"], out_dir=f"tmp/{launcher}", seed_outputs=True)
    raise NotImplementedError("TODO: call op(...) with the inputs in signature order")


def compare(name, got, want, tolerance):
    got, want = got.cpu(), want.cpu()
    if tolerance is None:
        ok, detail = torch.equal(got, want), "  exact"
    else:
        bounds = {k: v for k, v in tolerance.items() if k in ("rtol", "atol")}
        ok, detail = torch.allclose(got.float(), want.float(), **bounds), f"  tolerance={bounds}"
    worst = (got.float() - want.float()).abs().max().item()
    print(f"    {name:10s} {'ok  ' if ok else 'FAIL'}  max_abs_diff={worst:.3e}{detail}")
    return ok


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--launcher", default="sim", choices=LAUNCHERS)
    parser.add_argument("--backend", default="cce", choices=("cce", "pto_isa"))
    parser.add_argument("--case", default="all", help="a case id, or 'all'")
    parser.add_argument("--list", action="store_true", help="print the case ids and exit")
    args = parser.parse_args()
    if args.list:
        for case in CASES:
            print(f"{case['id']:16s} {case.get('purpose', '')}")
        return 0

    selected = [case for case in CASES if args.case in ("all", case["id"])]
    if not selected:
        parser.error(f"no case named {args.case!r}; --list prints them")
    failed = []
    for case in selected:
        print(f"{case['id']}  (launcher={args.launcher}, block_dim={case['block_dim']})")
        inputs = make_inputs(case)
        expected = reference(inputs)
        actual = execute(case, inputs, args.launcher, args.backend)
        for name in expected:
            if not compare(name, actual[name], expected[name], TOLERANCE):
                failed.append(f"{case['id']}/{name}")
    print(f"\n{len(selected) - len({f.split('/')[0] for f in failed})}/{len(selected)} cases passed")
    if failed:
        print("failed: " + ", ".join(failed))
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
